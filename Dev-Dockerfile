ARG FROM_IMAGE=netboxcommunity/netbox
ARG FROM_TAG=v4.2.9-3.2.1
ARG FROM=${FROM_IMAGE}:${FROM_TAG}
FROM ${FROM}

ENV VIRTUAL_ENV=/opt/netbox/venv
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

COPY ./netbox_cars /source/adestis-netbox-cars/netbox_cars/
COPY ./setup.py /source/adestis-netbox-cars/
COPY ./MANIFEST.in /source/adestis-netbox-cars/
COPY ./README.md /source/adestis-netbox-cars/
COPY ./docker/requirements-container.txt /source/adestis-netbox-cars/
COPY ./docker/configuration/configuration.py /etc/netbox/config/configuration.py
RUN /usr/local/bin/uv pip install /source/adestis-netbox-cars/
RUN /usr/local/bin/uv pip install -r /source/adestis-netbox-cars/requirements-container.txt
RUN /usr/local/bin/uv pip install adestis-netbox-applications==1.0.13